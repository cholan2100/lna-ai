# Qucs Netlist for 98 MHz Common Base LNA with CPWG Traces Modeled
# Substrate definition for LionCircuits 1.6mm FR-4, 1oz Cu
SUBST:Subst1 er=4.5 h=1.6mm t=35um tand=0.02 rho=1.72e-8 D=1.5e-6

# RF Ports (50 Ohm)
Pac:P1 rf_in gnd Num=1 Z=50 Ohm f=98 MHz
Pac:P2 rf_out gnd Num=2 Z=50 Ohm f=98 MHz

# Input CPWG trace from SMA J1 (X=0.0) to L1 tap (X=8.5mm): Length = 8.5 mm
CLIN:TL_IN rf_in in Subst="Subst1" W=1.5mm S=0.35mm L=8.5mm Backside="Metal"

# Input High-Pass L-Match Network: Shunt L1 to GND, Series C1 to Emitter
L:L1 in gnd L=27n
C:C1 in emitter C=100p

# Transistor Q1 MMBT5179 (Base, Collector, Emitter, Substrate)
BJT:Q1 base collector emitter gnd Is=1e-14 Nf=1 Nr=1 Ikf=0.1 Ikr=0.01 Vaf=50 Var=10 Ise=1e-14 Ne=1.5 Isc=0 Nc=2 Bf=90 Br=2 Rbm=0 Irb=0 Cje=1.2e-12 Vje=0.7 Mje=0.33 Cjc=1e-12 Vjc=0.5 Mjc=0.33 Xcjc=1 Cjs=0 Vjs=0.75 Mjs=0 Fc=0.5 Vtf=0 Tf=0.09e-9 Xtf=0 Itf=0 Tr=10e-9 Rb=10 Re=1 Rc=5 Type="npn"

# Emitter Bias & RF Choke
L:L2 emitter n_l2_2 L=470n
R:R3 n_l2_2 gnd R=200

# Base Bias & RF Grounding Bypass
Vdc:VCC vcc gnd U=5V
R:R1 vcc base R=3.9k
R:R2 base gnd R=3.3k
C:C3 base gnd C=100p
C:C4 base gnd C=1n
C:C5 base gnd C=100n

# VCC Power Decoupling
C:C11 vcc gnd C=10u
C:C12 vcc gnd C=100n

# Collector CPWG interconnect trace to tuned tank & C7 (Length = 6.6 mm)
CLIN:TL_COL collector n_c7_in Subst="Subst1" W=1.0mm S=0.35mm L=6.6mm Backside="Metal"

# Collector Tuned Tank (BPF Image Filter)
L:L3 n_c7_in vcc L=150n
C:C6 n_c7_in gnd C=6.8p

# Output Series L-Match & DC Block Capacitor
C:C7 n_c7_in n_c7_out C=10p

# Output CPWG Segment 1: C7 (X=26.45) to Bias-Tee tap (X=36.0): Length = 9.55 mm
CLIN:TL_OUT1 n_c7_out n_bt_tap Subst="Subst1" W=1.5mm S=0.35mm L=9.55mm Backside="Metal"

# Bias-Tee Choke & Bypass at X=36.0 mm
L:L4 n_bt_tap bt_dc L=1u
C:C9 bt_dc gnd C=100p
C:C10 bt_dc gnd C=10n
R:Rbt bt_dc gnd R=100k

# Output CPWG Segment 2: Bias-Tee tap (X=36.0) to SMA J2 (X=46.0): Length = 10.0 mm
CLIN:TL_OUT2 n_bt_tap rf_out Subst="Subst1" W=1.5mm S=0.35mm L=10.0mm Backside="Metal"

# Simulation Controls
.DC:DC1
.SP:SP1 Type=lin Start=70 MHz Stop=130 MHz Points=61
